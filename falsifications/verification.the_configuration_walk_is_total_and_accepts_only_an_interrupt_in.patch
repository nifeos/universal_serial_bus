                     let interrupt = d[3] & 0x3 == 0x3;
-                    let inbound = endpoint_number_and_direction & 0x80 != 0;
+                    let inbound = true;
                     let number = endpoint_number_and_direction & 0x0f;
                     let maximum_packet_bytes = u16::from_le_bytes([d[4], d[5]]) & 0x07ff;
