Falsifies `usb::verification::two_reports_produce_their_events_in_order`.

The defect: `changes` reports the modifier bits from the highest to the lowest, so a chord that
flips Left Control and Right Alt together arrives in the other order. Every event is still
present, still says the right thing, and the count is unchanged, so the bound harness stays green.

Expected to fail: the harness's "modifiers first" assertion.

diff --git a/src/boot_keyboard.rs b/src/boot_keyboard.rs
--- a/src/boot_keyboard.rs
+++ b/src/boot_keyboard.rs
@@ -346,7 +346,7 @@
     /// Whether the key at `position` changed.
     fn changed_at(before: &BootReport, after: &BootReport, position: u8) -> bool {
         if position < 8 {
-            return (before.modifiers ^ after.modifiers) & (1 << position) != 0;
+            return (before.modifiers ^ after.modifiers) & (1 << (7 - position)) != 0;
         }
         // A key goes up when the earlier report holds it and the later one does not, and down
         // the other way round. Only its first slot counts, so a usage a confused device reports
@@ -363,13 +363,13 @@
     /// The change at `position`, which [`Changes::changed_at`] found changed.
     fn at(&self, position: u8) -> KeyChange {
         if position < 8 {
-            let action = if self.after.modifiers & (1 << position) != 0 {
+            let action = if self.after.modifiers & (1 << (7 - position)) != 0 {
                 KeyAction::Press
             } else {
                 KeyAction::Release
             };
             return KeyChange {
-                usage: FIRST_MODIFIER_USAGE + position,
+                usage: FIRST_MODIFIER_USAGE + (7 - position),
                 action,
             };
         }
